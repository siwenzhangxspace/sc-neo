params {
    input_manifest = null
    output_dir = 'results'

    reference_genome = 'GRCh38/hg38'
    annotation_release = 'Ensembl release 112'
    reference_download_date = ''

    ref_star_index = null
    ref_genome_fasta = null
    ref_genome_gtf = null
    ref_protein_fasta = null

    ref_splice_gtex_h5ad = null
    ref_splice_tcga_control_h5ad = null
    ref_splice_exon_table = null
    ref_splice_transcript_table = null
    ref_splice_reference_gtf = null
    ref_splice_start_codon_table = null
    enable_strict_splice_phase = false
    enable_splice_exclude_documented_junctions = false

    ref_vep_cache_dir = null
    ref_dbsnp_vcf = null
    ref_dbsnp_vcf_index = null
    ref_cosmic_vcf = null
    ref_cosmic_vcf_index = null
    ref_variant_caller_fasta = null

    ref_trust4_sequence = null
    ref_trust4_imgt = null
    ref_immunogenicity_script = null

    // Optional generic immunopeptidome references. PCI-DB is one possible source, not a required format/source.
    enable_immunopeptidome_compare = false
    ref_immunopeptidome_healthy_tsv = null
    ref_immunopeptidome_tumor_tsv = null

    enable_read_trimming = false
    allow_single_end_reads = true
    runtime_container = null
    runtime_container_dir = null

    threshold_min_cells_per_type = 3
    threshold_min_tumor_variant_cells = 3
    threshold_hla_max_reads = 100000000
    threshold_variant_enrichment_fdr = 0.1
    threshold_variant_min_depth = 8
    threshold_variant_min_alt_reads = 3
    threshold_variant_min_vaf = 0.05
    threshold_variant_min_base_quality = 20
    threshold_variant_min_mapping_quality = 20
    threshold_population_af_max = 0.001

    peptide_class_i_lengths = '8,9,10,11'
    threshold_splice_gtex_n_max = 3
    threshold_splice_gtex_t_min = 20
    threshold_splice_min_reads = 3
    threshold_mhc_max_allele_chars = 900
    threshold_mhc_affinity_max = 150
    threshold_mhc_rank_el_max = 2

    tool_fastqc_cmd = 'fastqc'
    tool_fastp_cmd = 'fastp'
    tool_star_cmd = 'STAR'
    tool_samtools_cmd = 'samtools'
    tool_featurecounts_cmd = 'featureCounts'
    tool_optitype_cmd = 'optitype run'
    tool_variant_caller_cmd = 'scAllele'
    tool_altanalyze_cmd = 'altanalyze-nextflow'
    tool_bcftools_cmd = 'bcftools'

    tool_mhc_predictor_cmd = 'netMHCpan'
    tool_tcr_recognition_cmd = 'tabr_bert_predict'

    tool_tcr_assembler_cmd = 'trust-smartseq.pl'
    trust4_decompress_fastq = false
    trust4_decompress_cmd = 'gzip -dc'
    tool_blastp_cmd = 'blastp'
    tool_makeblastdb_cmd = 'makeblastdb'
    tool_python_cmd = 'python3'
    tool_variant_annotation_cmd = 'vep'
    tool_maf_converter_cmd = 'mafsmith'

    tool_fastp_extra_args = ''
    tool_star_extra_args = ''
    tool_featurecounts_extra_args = ''
    tool_optitype_extra_args = ''
    tool_variant_caller_extra_args = ''
    ref_vep_species = 'homo_sapiens'
    ref_vep_assembly = 'GRCh38'
    ref_vep_cache_version = '112'
    tool_variant_annotation_extra_args = ''
    tool_maf_converter_extra_args = ''
    tool_mhc_predictor_extra_args = ''
    tool_tcr_assembler_extra_args = ''
    tool_blastp_extra_args = ''
    tool_tcr_recognition_extra_args = ''

    output_publish_mode = 'copy'
}

outputDir = params.output_dir

process {
    executor = 'local'
    cpus = 1
    memory = 4.GB
    errorStrategy = 'terminate'

    withLabel: utility_light {
        cpus = 1
        memory = 4.GB
        maxForks = 64
    }

    withLabel: io_light {
        cpus = 2
        memory = 8.GB
        maxForks = 48
    }

    withLabel: cpu_medium {
        cpus = 8
        memory = 32.GB
        maxForks = 32
    }

    withLabel: cpu_threaded {
        cpus = 16
        memory = 48.GB
        maxForks = 20

    }

    withLabel: mem_high_threaded {
        cpus = 16
        memory = 96.GB
        maxForks = 9
    }

    withLabel: mem_extreme_batch {
        cpus = 96
        memory = 256.GB
        maxForks = 1
    }

    withLabel: annotation_heavy {
        cpus = 12
        memory = 96.GB
        maxForks = 8
    }

    withLabel: prediction_medium {
        cpus = 8
        memory = 32.GB
        maxForks = 24
    }

    withName: INPUT_VALIDATE_MANIFEST { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: READS_PREPARE { container = "${params.runtime_container_dir}/sc-neo-align.sif" }
    withName: ALIGN_READS { container = "${params.runtime_container_dir}/sc-neo-align.sif" }
    withName: HLA_CALL { container = "${params.runtime_container_dir}/sc-neo-hla.sif" }
    withName: HLA_SUMMARIZE { container = "${params.runtime_container_dir}/sc-neo-core.sif" }

    withName: VARIANT_CALL { container = "${params.runtime_container_dir}/s5_latest.sif" }
    withName: VARIANT_FILTER_QUALITY { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: VARIANT_SELECT_RECURRENT { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: VARIANT_BUILD_CELL_EVIDENCE { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: VARIANT_TEST_ENRICHMENT { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: VARIANT_ANNOTATE { container = "${params.runtime_container_dir}/vep.sif" }
    withName: VARIANT_CONVERT_MAF { container = "${params.runtime_container_dir}/sc-neo-mafsmith.sif" }
    withName: VARIANT_FILTER_SOMATIC { container = "${params.runtime_container_dir}/sc-neo-core.sif" }

    withName: SPLICE_BUILD_MATRIX { container = "${params.runtime_container_dir}/sc-neo-altanalyze.sif" }
    withName: SPLICE_FILTER_MANIFEST { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: SPLICE_NORMALIZE_MATRIX { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: SPLICE_FILTER_BACKGROUND { container = "${params.runtime_container_dir}/sc-neo-core.sif" }

    withName: PEPTIDE_GENERATE_MUTATION { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: PEPTIDE_GENERATE_SPLICING { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: PEPTIDE_COMPARE_IMMUNOPEPTIDOME { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: PEPTIDE_BYPASS_IMMUNOPEPTIDOME { container = "${params.runtime_container_dir}/sc-neo-core.sif" }

    withName: MHC_PREDICT_MUTATION { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: MHC_PREDICT_SPLICING { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: MHC_MERGE_BATCHES { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: MHC_FILTER_CANDIDATES { container = "${params.runtime_container_dir}/sc-neo-core.sif" }

    withName: TCR_ASSEMBLE { container = "${params.runtime_container_dir}/trust4-plus.sif" }
    withName: TCR_PARSE_CDR3 { container = "${params.runtime_container_dir}/sc-neo-core.sif" }

    withName: EXPRESSION_QUANTIFY { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: EXPRESSION_NORMALIZE { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: CANDIDATE_EXPRESSION_SUPPORT { container = "${params.runtime_container_dir}/sc-neo-core.sif" }

    withName: PREDICT_IMMUNOGENICITY { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: PREDICT_MATCH_KNOWN_EPITOPES { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: PREDICT_TCR_RECOGNITION { container = "${params.runtime_container_dir}/tabr-bert.sif" }
    withName: RESULT_INTEGRATE { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: CANDIDATE_INTEGRATE { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
    withName: CANDIDATE_TOPSIS { container = "${params.runtime_container_dir}/sc-neo-core.sif" }
}

profiles {
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        process.container = params.runtime_container ?: null
    }

    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
        process.container = params.runtime_container ?: null
    }

    docker {
        docker.enabled = true
        process.container = params.runtime_container ?: null
    }

    conda {
        conda.enabled = true
        process.conda = 'python=3.11 anndata=0.10.8 pandas=2.2.3 numpy=1.26.4 h5py=3.12.1 pysam biopython subread blast'
    }
}
