singularity {
    runOptions = '-B /mnt:/mnt -B /tmp:/tmp'
}
params {
    input_manifest = '/mnt/data/zhangsw/sc-neo-nextflow-data/manifest.tsv'
    output_dir = '/mnt/data/zhangsw/sc-neo-nextflow-data/results'
    // sc-neo-core.sif (built 2026-07-18) predates the subread addition to its
    // Dockerfile (2026-09-02), so featureCounts is not on the container PATH.
    // Point to the host subread 2.0.8 install via the /mnt bind mount instead.
    tool_featurecounts_cmd = '/mnt/data/zhangsw/zhongshan/convert_count_tools/subread-2.0.8-Linux-x86_64/bin/featureCounts'

    // Immunopeptidome compare: converted from the raw CSV exports (comma-delimited,
    // non-canonical headers) into tab-separated TSV with Peptide/HLA/Disease columns
    // (pcidb_healthy.csv -> pcidb_healthy.tsv, HCC_immunopeptide.csv -> HCC_immunopeptide.tsv).
    enable_immunopeptidome_compare = true
    ref_immunopeptidome_healthy_tsv = '/mnt/data/zhangsw/sc-neo-data/pcidb_healthy.tsv'
    ref_immunopeptidome_tumor_tsv = '/mnt/data/zhangsw/sc-neo-data/HCC_immunopeptide.tsv'
}
