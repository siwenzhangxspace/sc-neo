params {
    reference_genome = 'GRCh38/hg38'
    annotation_release = 'Ensembl release 112'
    reference_download_date = 'YYYY-MM-DD'

    ref_star_index = '/path/to/star/GRCh38_Ensembl112'
    ref_genome_fasta = '/path/to/GRCh38.primary_assembly.genome.fa'
    ref_genome_gtf = '/path/to/Homo_sapiens.GRCh38.112.gtf'
    // 蛋白参考供非移码肽段生成；移码仅使用与 VEP 组装及转录本版本匹配的 genome FASTA 和 GTF。
    ref_protein_fasta = '/path/to/Homo_sapiens.GRCh38.pep.all.fa'
    ref_splice_gtex_h5ad = '/path/to/references/gtex_junction_counts.h5ad'
    ref_splice_tcga_control_h5ad = '/path/to/references/tcga_normal_junction_counts.h5ad'

    ref_splice_exon_table = '/path/to/Alt91_db/Hs_Ensembl_exon.txt'
    ref_splice_transcript_table = '/path/to/Alt91_db/mRNA-ExonIDs.txt'
    ref_splice_reference_gtf = '/path/to/Homo_sapiens.GRCh38.91.gtf'
    ref_splice_start_codon_table = '/path/to/df_start_codon.txt'
    enable_strict_splice_phase = false
    enable_splice_exclude_documented_junctions = false

    ref_vep_cache_dir = '/path/to/vep/cache'
    ref_dbsnp_vcf = '/path/to/dbSNP/00-common_all.vcf.gz'
    ref_dbsnp_vcf_index = null
    ref_cosmic_vcf = '/path/to/COSMIC/Cosmic_Total_v101.vcf.gz'
    ref_cosmic_vcf_index = null
    ref_variant_caller_fasta = null

    ref_trust4_sequence = '/path/to/TRUST4/hg38_bcrtcr.fa'
    ref_trust4_imgt = '/path/to/TRUST4/human_IMGT+C.fa'
    ref_immunogenicity_script = '/path/to/predict_immunogenicity.py'

    // Optional generic immunopeptidome module.
    // The two TSVs need a peptide/sequence column. HLA and disease/tissue columns are optional metadata.
    // 同肽长 healthy BLAST 局部命中 identity=100% 时排除；tumor 命中仅作为证据。
    enable_immunopeptidome_compare = true
    ref_immunopeptidome_healthy_tsv = '/path/to/references/immunopeptidome_healthy.tsv'
    ref_immunopeptidome_tumor_tsv = '/path/to/references/immunopeptidome_tumor.tsv'

    threshold_splice_gtex_n_max = 3
    threshold_splice_gtex_t_min = 20
    threshold_splice_min_reads = 3
    threshold_mhc_max_allele_chars = 900
    threshold_mhc_affinity_max = 150
    threshold_mhc_rank_el_max = 2

    runtime_container = null
    runtime_container_dir = '/path/to/containers'

    tool_fastqc_cmd = 'fastqc'
    tool_fastp_cmd = 'fastp'
    tool_star_cmd = 'STAR'
    tool_samtools_cmd = 'samtools'
    tool_featurecounts_cmd = 'featureCounts'
    tool_optitype_cmd = 'optitype run'
    tool_variant_caller_cmd = 'scAllele'
    tool_altanalyze_cmd = '/usr/local/bin/altanalyze-nextflow'
    tool_bcftools_cmd = 'bcftools'
    tool_mhc_predictor_cmd = '/opt/netMHCpan/netMHCpan'
    tool_tcr_assembler_cmd = 'perl trust-smartseq.pl'
    tool_blastp_cmd = 'blastp'
    tool_makeblastdb_cmd = 'makeblastdb'
    tool_tcr_recognition_cmd = '/opt/tabr-bert/tabr_bert_predict'
    tool_variant_annotation_cmd = 'vep'
    tool_maf_converter_cmd = 'mafsmith'
    tool_python_cmd = 'python3'

    tool_featurecounts_extra_args = ''
    tool_blastp_extra_args = ''
    tool_tcr_recognition_extra_args = ''
    tool_mhc_predictor_extra_args = ''
    tool_variant_annotation_extra_args = ''
    tool_maf_converter_extra_args = ''

    ref_vep_species = 'homo_sapiens'
    ref_vep_assembly = 'GRCh38'
    ref_vep_cache_version = '112'
}

singularity {
    runOptions = '-B /mnt:/mnt'
}
